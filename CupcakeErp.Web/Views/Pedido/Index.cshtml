@model IEnumerable<CupcakeErp.Web.Models.Cupcake>

@{
    ViewData["Title"] = "Frente de Caixa - Vendas";
}

<div class="container mt-4">
    <h2>🛒 Frente de Caixa - Vendas</h2>
    <hr />

    <!-- Área de Alertas: Mostra se a venda deu certo ou se faltou estoque -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Erro"]</div>
    }

    <div class="row mt-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card cupcake-card h-100 p-3">
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold" style="color: #4a3b32;">@item.Nome</h5>
                            <p class="card-text text-muted small">@item.Descricao</p>
                            <h4 class="mt-3 fw-bold" style="color: #8b4513;">R$ @item.PrecoVenda.ToString("F2")</h4>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3">
                            <form asp-controller="Pedido" asp-action="Comprar" method="post">
                                <input type="hidden" name="idCupcake" value="@item.Id" />
                                <button type="submit" class="btn btn-comprar w-100 shadow-sm">
                                    🛒 Vender e Baixar Estoque
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-center text-muted">Nenhum cupcake cadastrado no momento.</p>
            </div>
        }
    </div>
</div>